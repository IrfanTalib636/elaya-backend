PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/elaya

# JWT
JWT_ACCESS_SECRET=your_access_secret_should_be_long_and_random
JWT_REFRESH_SECRET=your_refresh_secret_should_be_long_and_random
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000 

# Swagger — enabled by default in development; set true to expose in production
ENABLE_SWAGGER=true

# ── Local dev only (npm run seed:dev) ──────────────────────────────────────
SEED_ADMIN_EMAIL=admin@elaya.ch
SEED_ADMIN_PASSWORD=Admin1234!
SEED_STUDIO_EMAIL=studio@inkfree.ch
SEED_STUDIO_PASSWORD=Studio1234!

# ── Production one-time bootstrap (npm run bootstrap:admin) ──────────────────
# Set these only for the single bootstrap run, then remove from Railway/env.
# BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.ch
# BOOTSTRAP_ADMIN_PASSWORD=use-a-long-random-password-min-12-chars

# ── Email (password reset) ─────────────────────────────────────────────────
# EMAIL_PROVIDER=console logs reset links to the server console (local dev)
# EMAIL_PROVIDER=smtp sends via Nodemailer (production VPS)
EMAIL_PROVIDER=console
# Must match your SMTP mailbox domain (e.g. noreply@atleticobasel.com)
EMAIL_FROM=noreply@atleticobasel.com
APP_FRONTEND_URL=http://localhost:5173

# Customer app reset link (mobile M3 — deep link or app URL; mobile team sets on prod)
# APP_CUSTOMER_RESET_URL=elaya://reset-password

# SMTP (Metanet example — set EMAIL_PROVIDER=smtp on VPS)
# SMTP_HOST=atleticobasel.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@atleticobasel.com
# SMTP_PASS=your-mailbox-password

