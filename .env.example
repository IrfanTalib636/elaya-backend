PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/elaya

# Max JSON body size (JPEG signature base64; raise if sending merkblatt_pdf in same request)
JSON_BODY_LIMIT=512kb

# JWT
JWT_ACCESS_SECRET=your_access_secret_should_be_long_and_random
JWT_REFRESH_SECRET=your_refresh_secret_should_be_long_and_random
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000 

# Swagger — enabled by default in development; set true to expose in production
ENABLE_SWAGGER=true

# ── Local dev only (npm run seed:dev) ──────────────────────────────────────
SEED_ADMIN_EMAIL=admin@elaya.ch
SEED_ADMIN_PASSWORD=elaya@Admin1234!
SEED_STUDIO_EMAIL=studio@inkfree.ch
SEED_STUDIO_PASSWORD=Studio1234!

# ── Production one-time bootstrap (npm run bootstrap:admin) ──────────────────
# Set these only for the single bootstrap run, then remove from Railway/env.
# BOOTSTRAP_ADMIN_ENABLED=true
# BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.ch
# BOOTSTRAP_ADMIN_PASSWORD=use-a-long-random-password-min-12-chars

# ── Email (password reset) ─────────────────────────────────────────────────
# EMAIL_PROVIDER=console logs reset links to the server console (local dev)
# EMAIL_PROVIDER=smtp sends via Nodemailer (production VPS)
EMAIL_PROVIDER=console
# Must match your SMTP mailbox domain (e.g. noreply@atleticobasel.com)
EMAIL_FROM=noreply@atleticobasel.com
APP_FRONTEND_URL=http://localhost:5173

# ── Mobile deep links (Universal Links + App Links) ─────────────────────────
# Public HTTPS domain that serves /.well-known/* (can be the API host or a dedicated links subdomain).
APP_LINKS_DOMAIN=app.elaya.ch
# Apple Developer → Membership → Team ID
IOS_TEAM_ID=
IOS_BUNDLE_ID=com.elayaMobile.app
ANDROID_PACKAGE_NAME=com.elayaMobile.app
# Comma-separated SHA-256 fingerprints from your Android signing keystore (debug + release).
# keytool -list -v -keystore your.keystore -alias your-alias
ANDROID_SHA256_CERT_FINGERPRINTS=

# Customer password-reset link in e-mails (defaults to https://{APP_LINKS_DOMAIN}/reset-password)
# Use elaya://reset-password for custom-scheme-only testing without universal links.
# APP_CUSTOMER_RESET_URL=https://app.elaya.ch/reset-password
# APP_CUSTOMER_RESET_URL=elaya://reset-password

# ── Private file storage (photos) ───────────────────────────────────────────
# Photos stored on VPS disk; MongoDB holds metadata + file IDs only. No public URLs.
UPLOAD_ROOT=./uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_STAGING_TTL_HOURS=24

# ── AI (Claude via Anthropic — server-side only) ────────────────────────────
# Never put this key in the frontend or commit it to git.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Set to false to disable AI routes without removing the key
AI_ENABLED=true

# ── Socket.io (studio ↔ customer live chat) ─────────────────────────────────
# Optional path override (default /socket.io). Mobile/studio clients must match.
# SOCKET_IO_PATH=/socket.io

# SMTP (Metanet example — set EMAIL_PROVIDER=smtp on VPS)
# SMTP_HOST=atleticobasel.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@atleticobasel.com
# SMTP_PASS=your-mailbox-password


# Stripe — use sk_test_ / pk_test_ for local testing; swap to live keys in production
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=chf
